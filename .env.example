# 복사해서 .env로 저장하세요 (.env는 커밋 금지)
# 선택: Claude API 키. 있으면 Claude가 주 모델이 되고, 실패하면 아래 GPT → Upstage로 넘어간다
ANTHROPIC_API_KEY=
# 선택: 답변 모델 (기본 claude-fable-5-1), 검색 조건 뽑기만 다른 모델로 (예: claude-haiku-5-5 — 빠르고 저렴)
CLAUDE_MODEL=
CLAUDE_INTENT_MODEL=
# 선택: 생각 깊이 low|medium|high|xhigh|max (기본 low — 빠름)
CLAUDE_EFFORT=
# OpenAI GPT-6 Astra API 키 (모델: gpt-6-astra, 주 모델)
GPT_ASTRA_API_KEY=
# 선택: 비상 폴백. GPT_ASTRA_API_KEY가 429/401/403으로 실패할 때만 solar-pro4로 넘어감 (없으면 폴백 비활성, 2027-04-01부터는 이 폴백도 무효화됨)
UPSTAGE_API_KEY=
# 세션 서명 키: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 운영 DB: Neon PostgreSQL 접속 주소 (pooled, 예: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require)
# 있으면 이것을 쓰고, 없으면 Turso → 로컬 data/app.db 순서
DATABASE_URL=
# 선택: Postgres 연결 풀 크기 (기본 5)
DB_POOL_MAX=5
# Turso (Neon으로 옮기기 전 DB — 데이터 옮기기가 끝나면 비워도 된다)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 선택: 이 시간(ms) 이상 걸린 DB 쿼리를 db_slow_query 경고로 기록 (기본 500, 0이면 전부 기록)
DB_SLOW_QUERY_MS=500
# 선택: AI 호출 타임아웃(초)
LLM_TIMEOUT_SECONDS=20
# 선택: AI 호출 1번(재시도·폴백 포함)에 쓸 총 시간(초). /api/chat은 AI를 2번 부르고 Vercel 한도는 60초
LLM_CALL_BUDGET_SECONDS=25
# 선택: 5xx·연결 오류 시 같은 제공자 재시도 횟수 (타임아웃·429·401/403은 재시도 안 함)
LLM_MAX_RETRIES=1
# 선택: reasoning_effort (low|medium|high|xhigh|max, 기본 low — 비용 보호)
LLM_REASONING_EFFORT=low

# ---- 보수보안 에이전트 (장애 대응 + 보안 위협 탐지, app/guardian.py) ----
# Vercel Cron에서 /api/guardian/daily-digest 를 부를 때 쓰는 비밀값. 아무 랜덤 문자열.
CRON_SECRET=
# 선택: 긴급도 medium/high 사건 발생 시 GitHub 이슈를 자동으로 여는 데 쓰는 토큰 (issues:write 권한)
GITHUB_TOKEN=
# 선택: 이슈를 열 저장소 (기본값: KANGSIK-SEO/AITOOLLEARN-7-1)
GITHUB_REPO=

# ---- 설명 에이전트 (피어 리뷰용, /explain/<이 값>, app/explain.py) ----
# 비우면 항상 404 (비활성). 동료에게는 비밀번호가 아니라 "/explain/<이 값>" 링크 자체를 공유한다.
# 랜덤 문자열: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# 평가가 끝나면 Vercel 환경변수에서 지워서 끈다.
EXPLAIN_AGENT_SECRET=

# ---- 초대코드(프리미엄) ----
# 선택: 회원가입 시 이 값과 일치하는 코드를 입력하면 초대코드 회원(프리미엄)으로 가입된다. 비우면 비활성.
PREMIUM_CODE=
# 선택: 초대코드 회원 시간당 질문 상한 (기본 300, 일반 회원은 30)
CHAT_LIMIT_PER_HOUR_PREMIUM=300
# 선택: 초대코드 없는 회원의 평생 무료 질문 수 (기본 100, 넘으면 403 FREE_LIMIT_REACHED)
CHAT_LIFETIME_LIMIT_FREE=100
# 선택: 초대코드 회원에게 보여줄 추천 작품 수 (기본 100, 일반 회원은 6)
ART_RESULTS_LIMIT_PREMIUM=100
