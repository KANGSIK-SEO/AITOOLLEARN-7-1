# 복사해서 .env로 저장하세요 (.env는 커밋 금지)
# Upstage solar-pro3 API 키 (solar-pro3만 허용, 2027-04 이후 전 모델 차단)
UPSTAGE_API_KEY=
# 세션 서명 키: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Turso (없으면 로컬 data/app.db 사용)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 선택: AI 호출 타임아웃(초)
LLM_TIMEOUT_SECONDS=20
# 선택: 회원가입 시 이 값과 일치하는 코드를 입력하면 프리미엄으로 가입된다. 비우면 프리미엄 가입 비활성.
PREMIUM_CODE=
# 선택: 프리미엄 사용자 시간당 질문 상한 (기본 300, 일반 사용자는 30)
CHAT_LIMIT_PER_HOUR_PREMIUM=300
