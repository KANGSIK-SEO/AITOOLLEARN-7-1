# 복사해서 .env로 저장하세요 (.env는 커밋 금지)
# OpenAI GPT-6 Astra API 키 (모델: gpt-6-astra, 주 모델)
GPT_ASTRA_API_KEY=
# 선택: 비상 폴백. GPT_ASTRA_API_KEY가 429/401/403으로 실패할 때만 solar-pro4로 넘어감 (없으면 폴백 비활성, 2027-04-01부터는 이 폴백도 무효화됨)
UPSTAGE_API_KEY=
# 세션 서명 키: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Turso (없으면 로컬 data/app.db 사용)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 선택: AI 호출 타임아웃(초)
LLM_TIMEOUT_SECONDS=20
# 선택: reasoning_effort (low|medium|high|xhigh|max, 기본 low — 비용 보호)
LLM_REASONING_EFFORT=low

# ---- 보수보안 에이전트 (장애 대응 + 보안 위협 탐지, app/guardian.py) ----
# Vercel Cron에서 /api/guardian/daily-digest 를 부를 때 쓰는 비밀값. 아무 랜덤 문자열.
CRON_SECRET=
# 선택: 긴급도 medium/high 사건 발생 시 GitHub 이슈를 자동으로 여는 데 쓰는 토큰 (issues:write 권한)
GITHUB_TOKEN=
# 선택: 이슈를 열 저장소 (기본값: KANGSIK-SEO/AITOOLLEARN-7-1)
GITHUB_REPO=

# ---- 초대코드(프리미엄) ----
# 선택: 회원가입 시 이 값과 일치하는 코드를 입력하면 초대코드 회원(프리미엄)으로 가입된다. 비우면 비활성.
PREMIUM_CODE=
# 선택: 초대코드 회원 시간당 질문 상한 (기본 300, 일반 회원은 30)
CHAT_LIMIT_PER_HOUR_PREMIUM=300
# 선택: 초대코드 없는 회원의 평생 무료 질문 수 (기본 100, 넘으면 403 FREE_LIMIT_REACHED)
CHAT_LIFETIME_LIMIT_FREE=100
# 선택: 초대코드 회원에게 보여줄 추천 작품 수 (기본 100, 일반 회원은 6)
ART_RESULTS_LIMIT_PREMIUM=100
